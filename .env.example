# =============================================================================
# Rasi Astro - environment settings
#
# HOW TO USE
# - Local computer: copy this file to ".env.local" and fill in values there.
#   (.env.local is ignored by git - never commit real keys.)
# - Vercel: add the same names under Project > Settings > Environment Variables.
# - Run `npm run config:check` to validate everything (it never prints secrets).
#
# With NOTHING filled in, the app runs in DEMO mode: simulated payments, sample
# report text, emails saved to .data/emails, and a local database in .data/.
# =============================================================================

# ---- Mode -------------------------------------------------------------------
# demo = no real money, sample text, local everything. live = real providers only.
# Demo mode refuses to run on the production site (rasiastro.com).
APP_MODE=demo
# Public address of the site. Must be https:// in live mode.
PUBLIC_SITE_URL=http://localhost:3000
# Long random secret (at least 32 characters) used to protect rate-limit keys.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# ---- Database (Supabase PostgreSQL) -------------------------------------------
# Leave empty for the local demo database. In Supabase: Project > Connect >
# "Transaction pooler" connection string (port 6543), with your database password.
DATABASE_URL=
# Where the local demo database lives when DATABASE_URL is empty.
LOCAL_DB_DIR=.data/pglite

# ---- Payments (Cashfree) ------------------------------------------------------
# sandbox for testing, production for real money. The production site REQUIRES production.
CASHFREE_ENV=sandbox
# Cashfree Merchant Dashboard > Developers > API Keys (App ID and Secret Key).
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Cashfree API version the code was written against. Do not change casually.
CASHFREE_API_VERSION=2026-01-01

# ---- AI interpretation (OpenAI) -----------------------------------------------
AI_PROVIDER=openai
# platform.openai.com > API keys.
OPENAI_API_KEY=
# A model your account can use. There is NO default on purpose: run
# `npm run config:check` to list the models your key can access, then pick one.
OPENAI_MODEL=
# Optional, only for reasoning models: none | minimal | low | medium | high
OPENAI_REASONING_EFFORT=
# Time limit for one AI call (milliseconds) and maximum output size per report part.
AI_TIMEOUT_MS=240000
AI_MAX_OUTPUT_TOKENS=16000
# Safety cap: generation pauses (and you get an alert) if the last 24 hours used more tokens.
AI_DAILY_TOKEN_BUDGET=4000000
# Optional: your model's prices (USD per million tokens) so exports show estimated cost.
AI_PRICE_INPUT_PER_MTOK_USD=
AI_PRICE_OUTPUT_PER_MTOK_USD=

# ---- Email (Resend) -----------------------------------------------------------
# resend.com > API Keys. Also verify your sending domain in Resend > Domains.
RESEND_API_KEY=
# Must use your verified domain.
EMAIL_FROM=Rasi Astro <reports@rasiastro.com>
# Where customer replies go (defaults to SUPPORT_EMAIL).
EMAIL_REPLY_TO=
# Shown on the website, policy pages and emails.
SUPPORT_EMAIL=support@rasiastro.com
# Optional: where operational alerts go (failed reports, payments needing review).
OWNER_ALERT_EMAIL=

# ---- Report storage -----------------------------------------------------------
# local = .data/storage on this computer (demo only). supabase = private cloud bucket (live).
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/storage
# Supabase > Project Settings > API: Project URL and the secret / service_role key.
# The service key bypasses security rules: server only, never in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REPORTS_BUCKET=reports

# ---- Background jobs (Inngest) ------------------------------------------------
# local = run jobs inside the web server (demo only). inngest = durable jobs (live).
JOB_RUNNER=local
# Inngest dashboard > your app > Manage > Event Key / Signing Key.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set to 1 only when testing with the local Inngest dev server (npm run dev:inngest).
INNGEST_DEV=
# Maximum reports generated at the same time (protects AI rate limits).
REPORT_CONCURRENCY=3

# ---- PDF rendering ------------------------------------------------------------
# auto = serverless Chromium on Vercel, otherwise Chrome/Edge installed on this computer.
PDF_BROWSER=auto
# Only if Chrome/Edge is not found automatically.
CHROME_EXECUTABLE_PATH=
# Only with PDF_BROWSER=remote (a hosted browser service's WebSocket URL).
PDF_BROWSER_WS_ENDPOINT=

# ---- Privacy & retention ------------------------------------------------------
# How long email links work (days). Customers can always request a fresh link.
ACCESS_LINK_TTL_DAYS=30
# Delete abandoned unpaid orders after this many days.
RETENTION_UNPAID_DAYS=14
# Erase birth details, report and PDF this many days after payment
# (the financial record is kept). Check the right period with your accountant.
RETENTION_REPORT_DAYS=400

# ---- Operations ---------------------------------------------------------------
# Secret for detailed /api/health output (send header: Authorization: Bearer <token>).
HEALTH_CHECK_TOKEN=

# ---- Business details (shown on policy pages; required in live mode) ----------
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
GRIEVANCE_OFFICER_NAME=

# ---- Demo-mode extras (ignored in live mode) ----------------------------------
# true = use your real OpenAI key for report text while payments stay simulated.
DEMO_USE_REAL_AI=false
# true = send real emails through Resend while payments stay simulated.
DEMO_SEND_REAL_EMAIL=false
