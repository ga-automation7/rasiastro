# =============================================================================
# Rasi Astro - environment settings (every variable the code reads, nothing else)
#
# HOW TO USE
# - Local computer: copy this file to ".env.local" and fill in values there.
#   (.env.local is ignored by git - never commit real keys.)
# - Vercel: add the same names under Project > Settings > Environment Variables.
#   The full table (what each is, where to get it, secret or not) is in VERCEL_SETUP.md.
# - Run `npm run config:check` to validate everything (it never prints secrets).
#
# None of these names start with NEXT_PUBLIC_: nothing here is ever sent to browsers.
#
# With NOTHING filled in, the app runs locally in DEMO mode: simulated payments,
# sample report text, emails saved to .data/emails, and a local database in .data/.
# A hosted deployment never falls back to demo: it must set APP_MODE explicitly.
# =============================================================================

# ---- Mode -------------------------------------------------------------------
# demo    = simulated payments and sample report text (no real money, no paid services).
# sandbox = every real service, but the payment provider's TEST environment (no real money).
# live    = real money. Requires every live integration below.
# Demo and sandbox refuse to take orders on rasiastro.com.
APP_MODE=demo
# Public https address customers use (also used to build email links).
PUBLIC_SITE_URL=http://localhost:3000
# Long random secret (at least 32 characters) used to protect rate-limit keys.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# ---- Product switches (independent: turning one off never affects the other) ----
PERSONAL_ORDERS_ENABLED=true
COMPATIBILITY_ORDERS_ENABLED=true

# ---- Database (Supabase PostgreSQL) -------------------------------------------
# Leave empty for the local demo database. In Supabase: Project > Connect >
# "Transaction pooler" connection string (port 6543), with your database password.
DATABASE_URL=
# Where the local demo database lives when DATABASE_URL is empty.
LOCAL_DB_DIR=.data/pglite

# ---- Payments -------------------------------------------------------------------
# Provider for NEW checkouts (ignored in demo mode). Older payments always stay with
# the provider that created them, so switching later never breaks existing orders.
#   urorelay = UroRelay: UPI QR straight to your bank, confirmed from your bank's SMS
#              by the UroPay Companion app (app.uropay.me). Needs an Android phone.
#   uropay   = UroPay Merchant API (hosted checkout, dashboard.uropay.me, needs KYC).
#   cashfree = Cashfree Payments.
PAYMENT_PROVIDER=
# test (with APP_MODE=sandbox) or production (with APP_MODE=live). Mismatches are refused,
# and live payments are refused on Vercel Preview deployments.
PAYMENT_ENV=

# UroRelay: app.uropay.me > API Keys (one key pair; TEST or LIVE is chosen for your phone
# in the UroRelay dashboard). Webhook URL to enter there: https://www.rasiastro.com/api/webhooks/urorelay
UROPAY_RELAY_API_KEY=
UROPAY_RELAY_API_SECRET=

# UroPay Merchant API (a different product; not used by UroRelay). Separate TEST and
# PRODUCTION key pairs. Webhook: https://www.rasiastro.com/api/webhooks/uropay
UROPAY_TEST_API_KEY=
UROPAY_TEST_API_SECRET=
UROPAY_LIVE_API_KEY=
UROPAY_LIVE_API_SECRET=

# Cashfree Merchant Dashboard > Developers > API Keys. Test and live keys differ.
# Webhook: https://www.rasiastro.com/api/webhooks/cashfree
CASHFREE_TEST_CLIENT_ID=
CASHFREE_TEST_CLIENT_SECRET=
CASHFREE_LIVE_CLIENT_ID=
CASHFREE_LIVE_CLIENT_SECRET=
# Cashfree API version the code was written against. Do not change casually.
CASHFREE_API_VERSION=2026-01-01

# ---- AI interpretation (OpenAI) -----------------------------------------------
# platform.openai.com > API keys.
OPENAI_API_KEY=
# A model your account can use. There is NO default on purpose: run
# `npm run config:check` to list the models your key can access, then pick one.
OPENAI_MODEL=
# Optional: a different model for compatibility reports (defaults to OPENAI_MODEL).
OPENAI_MODEL_COMPATIBILITY=
# Optional, only for reasoning models: none | minimal | low | medium | high
OPENAI_REASONING_EFFORT=
# Time limit for one AI call (milliseconds; must stay below Vercel's 300 s step limit)
# and maximum output size per report part.
AI_TIMEOUT_MS=240000
AI_MAX_OUTPUT_TOKENS=16000
# Safety cap: generation pauses (and you get an alert) if the last 24 hours used more tokens.
AI_DAILY_TOKEN_BUDGET=4000000
# Optional: your model's prices (USD per million tokens) so exports show estimated cost.
AI_PRICE_INPUT_PER_MTOK_USD=
AI_PRICE_OUTPUT_PER_MTOK_USD=

# ---- Email (Resend) -----------------------------------------------------------
# resend.com > API Keys. Also verify your sending domain in Resend > Domains.
RESEND_API_KEY=
# Must use your verified domain.
EMAIL_FROM=Rasi Astro <reports@rasiastro.com>
# Where customer replies go (defaults to SUPPORT_EMAIL).
EMAIL_REPLY_TO=
# A real, monitored mailbox. Shown on the website, policy pages and emails.
SUPPORT_EMAIL=support@rasiastro.com
# Where operational alerts go (failed reports, payments needing review). Recommended.
OWNER_ALERT_EMAIL=

# ---- Report storage -----------------------------------------------------------
# local = .data/storage on this computer (local demo only). supabase = private cloud bucket.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/storage
# Supabase > Project Settings > API: Project URL and the secret / service_role key.
# The service key bypasses security rules: server only, never in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REPORTS_BUCKET=reports

# ---- Background jobs (Inngest) ------------------------------------------------
# local = run jobs inside the web server (local demo only). inngest = durable jobs.
JOB_RUNNER=local
# Set automatically by the Inngest Vercel integration; or Inngest dashboard > your app.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set to 1 only when testing with the local Inngest dev server (npm run dev:inngest).
INNGEST_DEV=
# Read by the Inngest SDK: your public https origin, so Inngest calls the custom domain.
# Example for production: https://www.rasiastro.com (the address that serves the site
# without redirecting; rasiastro.com currently redirects to www).
INNGEST_SERVE_ORIGIN=
# Maximum reports generated at the same time, per product (protects AI rate limits).
REPORT_CONCURRENCY=3

# ---- PDF rendering ------------------------------------------------------------
# auto = serverless Chromium on Vercel, otherwise Chrome/Edge installed on this computer.
PDF_BROWSER=auto
# Only if Chrome/Edge is not found automatically.
CHROME_EXECUTABLE_PATH=
# Only with PDF_BROWSER=remote (a hosted browser service's WebSocket URL).
PDF_BROWSER_WS_ENDPOINT=

# ---- Privacy & retention (shown in the Privacy Policy; enforced daily) ------------
# How long email links work (days). Customers can always request a fresh link.
ACCESS_LINK_TTL_DAYS=30
# Delete abandoned unpaid orders after this many days.
RETENTION_UNPAID_DAYS=14
# Erase birth details, report and PDF this many days after payment
# (the financial record is kept). Confirm the right period with your accountant.
RETENTION_REPORT_DAYS=400

# ---- Customer-facing service levels (shown in policies and FAQ) -----------------
# Set these from measured sandbox/live performance, not guesses.
DELIVERY_TYPICAL_MINUTES=30
DELIVERY_MAX_HOURS=24
REFUND_INITIATION_WORKING_DAYS=7

# ---- Owner dashboard (/admin) ----------------------------------------------------
# Email addresses allowed to sign in (comma separated). Empty = the dashboard is off.
# Sign-in is a 6-digit code emailed to that address (needs RESEND_API_KEY).
ADMIN_EMAILS=
# How long a sign-in lasts, in hours (1 to 72).
ADMIN_SESSION_HOURS=12

# ---- Operations ---------------------------------------------------------------
# Secret for detailed /api/health output (send header: Authorization: Bearer <token>).
HEALTH_CHECK_TOKEN=
# Optional: set to "debug" for extra log detail while troubleshooting (leave empty normally).
LOG_LEVEL=

# ---- Business details (shown on policy and contact pages; required in live mode) ----
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
# e.g. "Sole proprietorship (Udyam UDYAM-XX-00-0000000)" or "Private limited company, CIN ..."
BUSINESS_REGISTRATION=
# Only if registered for GST.
BUSINESS_GSTIN=
SUPPORT_PHONE=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_DESIGNATION=
# Default to SUPPORT_EMAIL / SUPPORT_PHONE when empty.
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=

# ---- Demo-mode extras (ignored outside demo mode) -------------------------------
# true = use your real OpenAI key for report text while payments stay simulated.
DEMO_USE_REAL_AI=false
# true = send real emails through Resend while payments stay simulated.
DEMO_SEND_REAL_EMAIL=false

# ---- Set automatically by the platform (do not add these yourself) --------------
# VERCEL, VERCEL_ENV, VERCEL_PROJECT_PRODUCTION_URL, NODE_ENV, NEXT_RUNTIME
