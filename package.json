{
  "name": "rasi-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rasi Astro - personalised astrology reports (rasiastro.com)",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:inngest": "npx --yes inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "config:check": "tsx scripts/check-config.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "places:import": "tsx scripts/places-import.ts",
    "storage:setup": "tsx scripts/storage-setup.ts",
    "export:xlsx": "tsx scripts/export-xlsx.ts",
    "ops:status": "tsx scripts/ops-status.ts",
    "ops:reconcile": "tsx scripts/ops-reconcile.ts",
    "ops:retry-report": "tsx scripts/ops-retry-report.ts",
    "ops:resend-email": "tsx scripts/ops-resend-email.ts",
    "ops:delete-order": "tsx scripts/ops-delete-order.ts",
    "ops:purge": "tsx scripts/ops-purge.ts",
    "verify:pdf": "tsx scripts/verify-pdf.ts",
    "fonts:copy": "tsx scripts/copy-fonts.ts",
    "ops:privacy-export": "tsx scripts/ops-privacy-export.ts",
    "images:build": "tsx scripts/build-images.ts",
    "fonts:subset": "tsx scripts/subset-fonts.ts"
  },
  "dependencies": {
    "@cashfreepayments/cashfree-js": "1.0.7",
    "@electric-sql/pglite": "0.5.8",
    "@sparticuz/chromium": "153.0.0",
    "@supabase/supabase-js": "2.117.2",
    "astronomy-engine": "2.1.19",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "inngest": "4.21.0",
    "motion": "13.4.6",
    "next": "16.3.7",
    "openai": "7.23.0",
    "postgres": "3.4.9",
    "puppeteer-core": "25.11.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/noto-sans-kannada": "5.3.0",
    "@fontsource/noto-sans-malayalam": "5.3.0",
    "@fontsource/noto-sans-tamil": "5.3.0",
    "@fontsource/noto-sans-telugu": "5.3.0",
    "@fontsource/noto-serif-malayalam": "5.3.0",
    "@fontsource/tiro-devanagari-hindi": "5.3.0",
    "@fontsource/tiro-kannada": "5.3.0",
    "@fontsource/tiro-tamil": "5.3.0",
    "@fontsource/tiro-telugu": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "pdfjs-dist": "6.3.289",
    "sharp": "0.35.5",
    "subset-font": "^2.9.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unpdf": "1.8.1",
    "vitest": "5.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
